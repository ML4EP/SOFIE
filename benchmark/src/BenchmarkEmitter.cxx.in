// SOFIE Benchmark Emitter
// Auto-configured by CMake — do not edit directly.
// For each .onnx model in benchmark/models/ this binary generates:
//   <ModelName>_GPU_ALPAKA.hxx  — SOFIE inference code
//   <ModelName>_GPU_ALPAKA.dat  — serialized weights
//   <ModelName>_bench.hxx       — timing function, following the same
//                                 pattern as the unit tests

#include "SOFIE/RModel_Base.hxx"
#include "SOFIE/RModel.hxx"
#include "SOFIE/RModelParser_ONNX.hxx"

#include <algorithm>
#include <cctype>
#include <fstream>
#include <iostream>
#include <map>
#include <set>
#include <sstream>
#include <string>
#include <utility>
#include <vector>

using namespace SOFIE;

static size_t resolveDim(const Dim &d, const std::map<std::string, int64_t> &overrides = {}) {
    if (d.isParam) {
        auto it = overrides.find(d.param);
        if (it != overrides.end())
            return static_cast<size_t>(it->second);
    }
    return (d.dim > 0) ? static_cast<size_t>(d.dim) : 1u;
}

namespace {

std::string SanitizeCppName(std::string name) {
    for (char &c : name)
        if (!std::isalnum(static_cast<unsigned char>(c))) c = '_';
    return name;
}

struct InputDimInfo {
    std::string name;
    std::vector<Dim> dims;
};

std::vector<InputDimInfo> CollectInputDims(RModel &model) {
    std::vector<InputDimInfo> result;
    for (const auto &n : model.GetInputTensorNames()) {
        InputDimInfo info;
        info.name = n;
        try {
            info.dims = model.GetDimTensorShape(n);
        } catch (...) {}
        result.push_back(std::move(info));
    }
    return result;
}

struct BaseFamilyInfo {
    std::string cppName;
    std::vector<InputDimInfo> inputDims;
};

// Parses and generates a dynamic-shape family's base model exactly once
// (memoized across every EmitBenchmarkModel() call in this process) and
// writes its shared <baseModelName>_GPU_ALPAKA.hxx/.dat. Every shape variant
// of the family reuses this one generated Session — it only supplies the
// runtime shape values (see EmitBenchmarkModel).
const BaseFamilyInfo &EnsureBaseFamilyGenerated(const std::string &baseOnnxPath,
                                                const std::string &baseModelName,
                                                const std::string &outDir)
{
    static std::map<std::string, BaseFamilyInfo> cache;

    auto it = cache.find(baseModelName);
    if (it != cache.end())
        return it->second;

    std::cout << "[Benchmark] Generating shared dynamic-shape model: "
              << baseOnnxPath << " (shared by all " << baseModelName << "_* variants)\n";

    RModelParser_ONNX parser;
    RModel baseModel = parser.Parse(baseOnnxPath);

    BaseFamilyInfo info;
    info.inputDims = CollectInputDims(baseModel);
    info.cppName = SanitizeCppName(baseModelName);

#ifdef SOFIE_BENCHMARK_PROFILE
    baseModel.GenerateGPU_ALPAKA(Options::kProfile);
#else
    baseModel.GenerateGPU_ALPAKA();
#endif

    std::string baseHxxPath = outDir + "/" + baseModelName + "_GPU_ALPAKA.hxx";
    baseModel.OutputGenerated(baseHxxPath);
    std::cout << "[Benchmark] Wrote: " << baseHxxPath << "\n";

    auto inserted = cache.emplace(baseModelName, std::move(info));
    return inserted.first->second;
}

} // namespace

static int EmitBenchmarkModel(const std::string &onnxPath,
                              const std::string &modelName,
                              const std::string &outDir,
                              const std::string &baseOnnxPath = "",
                              const std::string &baseModelName = "",
                              const std::map<std::string, int64_t> &shapeOverrides = {})
{
    const bool isDynamicFamily = !baseOnnxPath.empty();

    std::cout << "[Benchmark] Processing: " << modelName;
    if (isDynamicFamily)
        std::cout << " (dynamic shape variant of " << baseModelName << ")";
    std::cout << "\n";

    RModelParser_ONNX parser;
    RModel model = parser.Parse(isDynamicFamily ? baseOnnxPath : onnxPath);

    const auto &inputNames = model.GetInputTensorNames();
    if (inputNames.empty()) {
        std::cerr << "[WARN] " << modelName << " has no inputs – skipping.\n";
        return 1;
    }

    // Map SOFIE tensor type to C++ type string
    auto tensorTypeToCpp = [](ETensorType t) -> std::string {
        switch (t) {
            case ETensorType::FLOAT:  return "float";
            case ETensorType::DOUBLE: return "double";
            case ETensorType::INT32:  return "int32_t";
            case ETensorType::INT64:  return "int64_t";
            case ETensorType::UINT8:  return "uint8_t";
            case ETensorType::INT8:   return "int8_t";
            case ETensorType::UINT16: return "uint16_t";
            case ETensorType::INT16:  return "int16_t";
            case ETensorType::UINT32: return "uint32_t";
            case ETensorType::UINT64: return "uint64_t";
            case ETensorType::BOOL:   return "uint8_t";
            default:                  return "float";
        }
    };

    // Collect input metadata before code generation
    struct TensorMeta {
        std::string name;
        ETensorType type;
        std::string cppType;
        size_t numElements;
        std::vector<size_t> shape;
    };
    std::vector<TensorMeta> inputs;
    for (const auto &n : inputNames) {
        TensorMeta m;
        m.name = n;
        try {
            m.type = model.GetTensorType(n);
            m.cppType = tensorTypeToCpp(m.type);
        } catch (...) {
            m.type = ETensorType::FLOAT;
            m.cppType = "float";
        }
        m.numElements = 1;
        try {
            for (const auto &d : model.GetDimTensorShape(n)) {
                const size_t dim = resolveDim(d, shapeOverrides);
                m.shape.push_back(dim);
                m.numElements *= dim;
            }
        } catch (...) {}
        inputs.push_back(m);
    }

    const BaseFamilyInfo *baseInfo = nullptr;
    if (isDynamicFamily)
        baseInfo = &EnsureBaseFamilyGenerated(baseOnnxPath, baseModelName, outDir);

    // Generate SOFIE GPU/Alpaka inference code for this exact model object —
    // this calls Initialize() which runs shape inference on all operators.
    // Output tensor shapes are only available *after* Initialize(), so we
    // must call GenerateGPU_ALPAKA() before querying output metadata.
#ifdef SOFIE_BENCHMARK_PROFILE
    model.GenerateGPU_ALPAKA(Options::kProfile);
#else
    model.GenerateGPU_ALPAKA();
#endif

    // Collect output metadata AFTER code generation so shapes are fully propagated.
    const auto &outputNames = model.GetOutputTensorNames();
    std::vector<TensorMeta> outputs;
    for (const auto &n : outputNames) {
        TensorMeta m;
        try {
            m.type = model.GetTensorType(n);
            m.cppType = tensorTypeToCpp(m.type);
        } catch (...) {
            m.type = ETensorType::FLOAT;
            m.cppType = "float";
        }
        m.numElements = 1;
        try {
            for (const auto &d : model.GetDimTensorShape(n)) {
                const size_t dim = resolveDim(d, shapeOverrides);
                m.shape.push_back(dim);
                m.numElements *= dim;
            }
        } catch (...) {}
        outputs.push_back(m);
    }

    std::string hxxPath  = outDir + "/" + modelName + "_GPU_ALPAKA.hxx";
    std::string benchPath = outDir + "/" + modelName + "_bench.hxx";
    std::string aotMetaPath = outDir + "/" + modelName + "_aot_meta.hxx";

    if (!isDynamicFamily)
        model.OutputGenerated(hxxPath);

    // Sanitize model name into a valid C++ identifier
    std::string cppName = SanitizeCppName(modelName);

    const std::string &sessionCppName = isDynamicFamily ? baseInfo->cppName : cppName;

    std::vector<std::vector<std::pair<std::string, size_t>>> newParamsPerInput(inputs.size());
    std::vector<std::pair<std::string, size_t>> orderedParams;
    if (isDynamicFamily) {
        const auto &baseInputs = baseInfo->inputDims;
        if (baseInputs.size() != inputs.size())
            throw std::runtime_error(modelName + ": has " + std::to_string(inputs.size()) +
                                     " input(s) but base model " + baseModelName + " has " +
                                     std::to_string(baseInputs.size()));
        std::set<std::string> seen;
        for (size_t i = 0; i < inputs.size(); ++i) {
            if (baseInputs[i].name != inputs[i].name)
                throw std::runtime_error(modelName + ": input " + std::to_string(i) + " is '" +
                                         inputs[i].name + "' but base model " + baseModelName +
                                         " input " + std::to_string(i) + " is '" + baseInputs[i].name + "'");
            const auto &baseDims = baseInputs[i].dims;
            for (size_t j = 0; j < baseDims.size() && j < inputs[i].shape.size(); ++j) {
                if (baseDims[j].isParam && seen.insert(baseDims[j].param).second) {
                    newParamsPerInput[i].push_back({baseDims[j].param, inputs[i].shape[j]});
                    orderedParams.push_back({baseDims[j].param, inputs[i].shape[j]});
                }
            }
        }
    }

    std::ofstream aotMeta(aotMetaPath);
    if (!aotMeta.is_open()) {
        std::cerr << "[ERROR] Cannot open " << aotMetaPath << "\n";
        return 1;
    }

    aotMeta << "#pragma once\n\n";
    aotMeta << "#include \"AOTInductorBenchmark.hxx\"\n\n";
    aotMeta << "inline std::vector<AOTInputSpec> GetAOTInputSpecs_" << cppName << "() {\n";
    aotMeta << "    return {\n";

    for (const auto &input : inputs) {
        aotMeta << "        {AOTDataType::";

        switch (input.type) {
            case ETensorType::FLOAT:  aotMeta << "Float32"; break;
            case ETensorType::DOUBLE: aotMeta << "Float64"; break;
            case ETensorType::INT32:  aotMeta << "Int32"; break;
            case ETensorType::INT64:  aotMeta << "Int64"; break;
            case ETensorType::UINT8:  aotMeta << "UInt8"; break;
            case ETensorType::INT8:   aotMeta << "Int8"; break;
            case ETensorType::INT16:  aotMeta << "Int16"; break;
            case ETensorType::BOOL:   aotMeta << "Bool"; break;
            default:                  aotMeta << "Unsupported"; break;
        }

        aotMeta << ", {";

        for (size_t i = 0; i < input.shape.size(); ++i) {
            if (i)
                aotMeta << ", ";
            aotMeta << input.shape[i];
        }

        aotMeta << "}},\n";
    }

    aotMeta << "    };\n";
    aotMeta << "}\n";

    std::ostringstream inferCall;
    std::ostringstream inferCallNosync;
    inferCall << "session.infer(";
    inferCallNosync << "session.infer_nosync(";
    {
        bool first = true;
        auto emit = [&](const std::string &tok) {
            if (!first) { inferCall << ", "; inferCallNosync << ", "; }
            inferCall << tok;
            inferCallNosync << tok;
            first = false;
        };
        for (size_t i = 0; i < inputs.size(); ++i) {
            for (auto &p : newParamsPerInput[i])
                emit(std::to_string(p.second));
            emit("input_d_" + std::to_string(i));
        }
    }
    inferCall << ")";
    inferCallNosync << ")";

    std::ofstream bench(benchPath);
    if (!bench.is_open()) {
        std::cerr << "[ERROR] Cannot open " << benchPath << "\n";
        return 1;
    }

    bench
        << "// Auto-generated benchmark for model: " << modelName << "\n"
        << "// DO NOT EDIT — regenerated by the SOFIE benchmark emitter.\n"
        << "// Backend is selected at compile time via -DSOFIE_BACKEND_CUDA / -DSOFIE_BACKEND_HIP\n"
        << "// (see BenchmarkBackend.hxx for the sofie_bench:: type aliases).\n"
        << "#pragma once\n\n"
        << "#include \"" << sessionCppName << "_GPU_ALPAKA.hxx\"\n"
        << "#include \"BenchmarkBackend.hxx\"\n"
        << "#include \"GPUProfiler.hxx\"\n"
        << "#include \"GPUMemoryMonitor.hxx\"\n"
        << "#include \"WarmupUtil.hxx\"\n"
        << "#include <chrono>\n"
        << "#include <fstream>\n"
        << "#include <iostream>\n"
        << "#include <random>\n"
        << "#include <string>\n\n"
        << "void Benchmark_" << cppName
        << "(int warmup, int iterations, const std::string& weightsDir, bool profile) {\n"
        << "    using namespace sofie_bench;\n\n"
        << "    // ---- Device/host setup (mirrors unit-test pattern) ----\n"
        << "    alpaka::PlatformCpu hostPlatform{};\n"
        << "    auto host = alpaka::getDevByIdx(hostPlatform, 0u);\n"
        << "    Platform platform{};\n"
        << "    auto device = alpaka::getDevByIdx(platform, 0u);\n"
        << "    Queue queue{device};\n\n"
        << "    std::mt19937 rng(42);\n"
        << "    std::uniform_real_distribution<float> fdist(-1.0f, 1.0f);\n\n";


    auto toLower = [](std::string s) {
        std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return std::tolower(c); });
        return s;
    };

    const bool isMlpf = toLower(cppName).find("mlpf") != std::string::npos;
    for (size_t i = 0; i < inputs.size(); ++i) {
        const std::string &T = inputs[i].cppType;
        const size_t       N = inputs[i].numElements;

        const std::string lname = toLower(inputs[i].name);
        const bool isMask = lname.find("mask") != std::string::npos;
        bench
            << "    // Input " << i << ": " << T << "[" << N << "]\n"
            << "    auto input_h_" << i << " = alpaka::allocBuf<" << T
            << ", Idx>(host, Ext1::all(Idx{" << N << "}));\n"
            << "    {\n"
            << "        auto *p = reinterpret_cast<" << T
            << "*>(alpaka::getPtrNative(input_h_" << i << "));\n";
        if (isMask && (T == "float" || T == "double")) {
            bench
                << "        std::fill(p, p + " << N << ", static_cast<" << T << ">(1));\n";
        } else if (isMlpf && (T == "float" || T == "double")) {
            bench
                << "        for (size_t k = 0; k < " << N
                << "; ++k) p[k] = static_cast<" << T << ">(0.01f + 0.5f * (fdist(rng) + 1.0f));\n";
        } else if (T == "float" || T == "double") {
            bench
                << "        for (size_t k = 0; k < " << N
                << "; ++k) p[k] = static_cast<" << T << ">(fdist(rng));\n";
        } else {
            bench
                << "        std::fill(p, p + " << N
                << ", static_cast<" << T << ">(0));\n";
        }
        bench
            << "    }\n"
            << "    auto input_d_" << i << " = alpaka::allocBuf<" << T
            << ", Idx>(device, Ext1::all(Idx{" << N << "}));\n"
            << "    alpaka::memcpy(queue, input_d_" << i
            << ", input_h_" << i << ");\n\n";
    }
    bench << "    alpaka::wait(queue);\n\n";

    std::ostringstream ctorArgs;
    for (auto &p : orderedParams)
        ctorArgs << ", " << p.second;

    bench
        << "    // ---- Create session (loads weights) ----\n"
        << "    std::string weightFile = weightsDir + \"/"
        << sessionCppName << "_GPU_ALPAKA.dat\";\n"
        << "    SOFIE_" << sessionCppName
        << "::Session<AccTag> session(weightFile" << ctorArgs.str() << ");\n"
        << "    double sofie_pool_mem_mb = "
        << "static_cast<double>(session.GetIntermediateMemoryPoolSize()) / (1024.0 * 1024.0);\n"

        << "    double sofie_free_mem_mb = "
        << "static_cast<double>(session.GetTotalFreeMemory()) / (1024.0 * 1024.0);\n"

        << "    double sofie_largest_free_mb = "
        << "static_cast<double>(session.GetLargestFreeBlock()) / (1024.0 * 1024.0);\n"

        << "    double sofie_used_mem_mb = "
        << "sofie_pool_mem_mb - sofie_free_mem_mb;\n"

        << "    double sofie_fragmentation = "
        << "100.0 * session.GetFragmentation();\n"

        << "    GPUMemoryMonitor gpuMem;\n\n";


    bench << "    // ---- One priming inference to obtain output buffer handle(s) ----\n"
          << "    auto out_d = " << inferCall.str() << ";\n"
          << "    alpaka::wait(session.queue);\n\n";

    for (size_t i = 0; i < outputs.size(); ++i) {
        const std::string &T = outputs[i].cppType;
        const size_t       N = outputs[i].numElements;
        bench
            << "    // Output " << i << ": " << T << "[" << N << "]\n"
            << "    auto out_h_" << i << " = alpaka::allocBuf<" << T
            << ", Idx>(host, Ext1::all(Idx{" << N << "}));\n";
    }
    bench << "\n";

    auto outBufExpr = [&](size_t i) -> std::string {
        if (outputs.size() == 1) return "out_d";
        return "std::get<" + std::to_string(i) + ">(out_d)";
    };

    bench << "    // ---- Warmup (not timed) ----\n"
          << "    sofie_bench::RunWarmup([&]() {\n";
    // H2D: inputs host → device
    for (size_t i = 0; i < inputs.size(); ++i)
        bench << "        alpaka::memcpy(queue, input_d_" << i
              << ", input_h_" << i << ");\n";
    bench << "        alpaka::wait(queue);\n";
    // Inference
    bench << "        " << inferCall.str() << ";\n"
          << "        alpaka::wait(session.queue);\n";
    // D2H: outputs device → host
    for (size_t i = 0; i < outputs.size(); ++i)
        bench << "        alpaka::memcpy(queue, out_h_" << i
              << ", " << outBufExpr(i) << ");\n";
    bench << "        alpaka::wait(queue);\n"
          << "        return true;\n"
          << "    }, warmup);\n"
          << "    cudaDeviceSynchronize();\n\n";

    // ---- Profiling path (mutually exclusive with benchmark path) ----
    bench << "#ifdef SOFIE_BENCHMARK_PROFILE\n"
          << "    // ---- Profile exactly one steady-state inference ----\n"
          << "    session.ResetProfilingResults();\n"
          << "    SOFIE_BENCH_DEVICE_SYNC();\n"
          << "    StartGpuProfiler();\n"
          << "    auto profiled_out_d = " << inferCall.str() << ";\n"
          << "    alpaka::wait(session.queue);\n"
          << "    SOFIE_BENCH_DEVICE_SYNC();\n"
          << "    StopGpuProfiler();\n"
          << "    (void)profiled_out_d;\n"
          << "    std::printf(\"%s\\n\", std::string(60, '-').c_str());\n"
          << "    std::printf(\"Model: " << modelName << "\\n\");\n"
          << "    session.PrintProfilingResults();\n"
          << "    session.PrintMemoryInfo();\n"
          << "#else\n";

    // ---- Benchmark path ----
    bench
        << "    // ---- Timed input transfer (H2D: host -> device) ----\n"
        << "    auto t0_in = std::chrono::high_resolution_clock::now();\n"
        << "    for (int _i = 0; _i < iterations; ++_i) {\n";
    for (size_t i = 0; i < inputs.size(); ++i)
        bench << "        alpaka::memcpy(queue, input_d_" << i
              << ", input_h_" << i << ");\n";
    bench << "        alpaka::wait(queue);\n"
          << "    }\n"
          << "    SOFIE_BENCH_DEVICE_SYNC();\n"
          << "    auto t1_in = std::chrono::high_resolution_clock::now();\n\n";

    bench
        << "    // ---- Timed inference ----\n"
        << "    gpuMem.Start();\n"
        << "    if (profile) {\n"
        << "        SOFIE_BENCH_DEVICE_SYNC();\n"
        << "        StartGpuProfiler();\n"
        << "    }\n"
        << "    auto t0_infer = std::chrono::high_resolution_clock::now();\n"
        << "    for (int _i = 0; _i < iterations; ++_i)\n"
        << "        " << inferCallNosync.str() << ";\n"
        << "    alpaka::wait(session.queue);\n"
        << "    SOFIE_BENCH_DEVICE_SYNC();\n"
        << "    auto t1_infer = std::chrono::high_resolution_clock::now();\n"
        << "    if (profile)\n"
        << "        StopGpuProfiler();\n"
        << "    gpuMem.Stop();\n"
        << "    double gpu_peak_mem_mb = gpuMem.PeakMB();\n\n";

    bench
        << "    // ---- Timed output transfer (D2H: device -> host) ----\n"
        << "    auto t0_out = std::chrono::high_resolution_clock::now();\n"
        << "    for (int _i = 0; _i < iterations; ++_i) {\n";
    for (size_t i = 0; i < outputs.size(); ++i)
        bench << "        alpaka::memcpy(queue, out_h_" << i
              << ", " << outBufExpr(i) << ");\n";
    bench << "        alpaka::wait(queue);\n"
          << "    }\n"
          << "    SOFIE_BENCH_DEVICE_SYNC();\n"
          << "    auto t1_out = std::chrono::high_resolution_clock::now();\n\n";

    bench
        << "    double avg_infer_ms  = std::chrono::duration<double, std::milli>"
           "(t1_infer - t0_infer).count() / iterations;\n"
        << "    double avg_in_ms     = std::chrono::duration<double, std::milli>"
           "(t1_in    - t0_in   ).count() / iterations;\n"
        << "    double avg_out_ms    = std::chrono::duration<double, std::milli>"
           "(t1_out   - t0_out  ).count() / iterations;\n"
        << "    double throughput    = (avg_infer_ms > 0.0) ? 1000.0 / avg_infer_ms : 0.0;\n\n"
        << "    std::printf(\"%-50s %12.4f %14.4f %15.4f %16.1f %10.2f %10.2f %10.2f %10.2f %10.2f %12.2f\\n\", "
        << "                \"" << modelName << "\",\n"
        << "                avg_infer_ms,\n"
        << "                avg_in_ms,\n"
        << "                avg_out_ms,\n"
        << "                throughput,\n"
        << "                sofie_pool_mem_mb,\n"
        << "                sofie_used_mem_mb,\n"
        << "                sofie_free_mem_mb,\n"
        << "                sofie_largest_free_mb,\n"
        << "                sofie_fragmentation,\n"
        << "                gpu_peak_mem_mb);\n"
        << "    {\n"
        << "        const char *resultsPath = std::getenv(\"SOFIE_BENCHMARK_RESULTS\");\n"
        << "        std::ofstream results(resultsPath ? resultsPath : \"@SOFIE_BENCHMARK_DEFAULT_RESULTS_DIR@/benchmark.csv\", std::ios::app);\n"
        << "        results << \"" << modelName << ",\"\n"
        << "                << avg_infer_ms << \",\"\n"
        << "                << avg_in_ms << \",\"\n"
        << "                << avg_out_ms << \",\"\n"
        << "                << throughput << \",\"\n"
        << "                << sofie_pool_mem_mb << \",\"\n"
        << "                << sofie_used_mem_mb << \",\"\n"
        << "                << sofie_free_mem_mb << \",\"\n"
        << "                << sofie_largest_free_mb << \",\"\n"
        << "                << sofie_fragmentation << \",\"\n"
        << "                << gpu_peak_mem_mb << \"\\n\";\n"
        << "    }\n"
        << "#endif  // SOFIE_BENCHMARK_PROFILE\n"
        << "}\n";

    bench.close();

    if (!isDynamicFamily)
        std::cout << "[Benchmark] Wrote: " << hxxPath << "\n";
    std::cout << "            Wrote: " << benchPath;
    if (isDynamicFamily) {
        std::cout << "  (shapes:";
        for (auto &p : orderedParams)
            std::cout << " " << p.first << "=" << p.second;
        std::cout << ")";
    }
    std::cout << "\n";
    return 0;
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        std::cerr << "Usage: sofie_benchmark_emitter <output_dir>\n";
        return 1;
    }
    std::string outDir = argv[1];
    int failures = 0;

@BENCHMARK_EMIT_CAPTURES@

    std::cout << "[Benchmark Emitter] Done — " << failures << " failure(s).\n";
    return failures == 0 ? 0 : 1;
}
